<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SheGuard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sheguard_primary</item>
        <item name="colorPrimaryVariant">@color/sheguard_primary_dark</item>
        <item name="colorSecondary">@color/sheguard_accent</item>
        <item name="colorSecondaryVariant">@color/sheguard_primary</item>
        <item name="colorSurface">@color/sheguard_card</item>
        <item name="android:colorBackground">@color/sheguard_surface</item>
        <item name="android:statusBarColor">@color/sheguard_primary_dark</item>
        <item name="android:navigationBarColor">@color/sheguard_card</item>
        <item name="materialButtonStyle">@style/Widget.SheGuard.Button</item>
        <item name="textInputStyle">@style/Widget.SheGuard.TextInputLayout</item>
    </style>

    <style name="Widget.SheGuard.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="backgroundTint">@color/sheguard_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.SheGuard.OutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/sheguard_border</item>
        <item name="android:textColor">@color/sheguard_text</item>
    </style>

    <style name="Widget.SheGuard.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxCornerRadiusTopStart">20dp</item>
        <item name="boxCornerRadiusTopEnd">20dp</item>
        <item name="boxCornerRadiusBottomStart">20dp</item>
        <item name="boxCornerRadiusBottomEnd">20dp</item>
        <item name="boxStrokeColor">@color/sheguard_border</item>
        <item name="hintTextColor">@color/sheguard_text_muted</item>
    </style>

    <style name="Widget.SheGuard.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeColor">@color/sheguard_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.SheGuard.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
        <item name="android:background">@color/sheguard_primary</item>
    </style>
    
</resources>
